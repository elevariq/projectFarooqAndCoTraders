# Phase 3: the real app files live here and must NEVER be fetched directly —
# the only way to them is api/gate.php, which reads them off disk after
# checking the sign-in. Same deny pattern as database/, docs/, app/ etc.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
Options -Indexes
